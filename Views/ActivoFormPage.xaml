<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EventAssetTracker.Views.ActivoFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="{Binding Title}"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1E2A38" />

            <Border
                BackgroundColor="White"
                Stroke="#DDDDDD"
                StrokeThickness="1"
                Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label Text="Nombre del activo" TextColor="#1E2A38" FontAttributes="Bold" />
                    <Entry
                        Text="{Binding Nombre}"
                        Placeholder="Ejemplo: Bocina JBL"
                        BackgroundColor="#F5F5F5" />

                    <Label Text="Código de inventario" TextColor="#1E2A38" FontAttributes="Bold" />
                    <Entry
                        Text="{Binding CodigoInventario}"
                        Placeholder="Ejemplo: EVT-001"
                        BackgroundColor="#F5F5F5" />

                    <Label Text="Ubicación" TextColor="#1E2A38" FontAttributes="Bold" />
                    <Entry
                        Text="{Binding Ubicacion}"
                        Placeholder="Ejemplo: Bodega principal"
                        BackgroundColor="#F5F5F5" />

                    <Label Text="Responsable" TextColor="#1E2A38" FontAttributes="Bold" />
                    <Entry
                        Text="{Binding Responsable}"
                        Placeholder="Ejemplo: Carlos Ruiz"
                        BackgroundColor="#F5F5F5" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Nota: Al crear un activo nuevo, el estado inicial será En Uso automáticamente."
                FontSize="13"
                TextColor="#777777" />

            <Button
                Text="Guardar"
                Command="{Binding GuardarCommand}"
                BackgroundColor="#2A9D8F"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50" />

            <Button
                Text="Cancelar"
                Command="{Binding CancelarCommand}"
                BackgroundColor="#E76F51"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>