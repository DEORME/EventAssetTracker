<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EventAssetTracker.Views.CambiarEstadoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Cambiar Estado"
    BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="Cambiar Estado"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#1E2A38" />

            <Border
                BackgroundColor="White"
                Stroke="#DDDDDD"
                StrokeThickness="1"
                Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="{Binding NombreActivo}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#1E2A38" />

                    <Label
                        Text="{Binding EstadoActual, StringFormat='Estado actual: {0}'}"
                        FontSize="16"
                        TextColor="#555555" />

                    <Label
                        Text="Selecciona el nuevo estado"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#1E2A38" />

                    <Picker
                        ItemsSource="{Binding EstadosDisponibles}"
                        SelectedItem="{Binding EstadoSeleccionado}"
                        BackgroundColor="#F5F5F5"
                        TextColor="#1E2A38" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="Guardar cambio"
                Command="{Binding ConfirmarCambioCommand}"
                BackgroundColor="#2A9D8F"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50" />

            <Button
                Text="Cancelar"
                Command="{Binding CancelarCommand}"
                BackgroundColor="#E76F51"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>